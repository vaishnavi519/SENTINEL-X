# SENTINEL-X — Environment Variables
# Copy this file to .env and fill in values.
# The system works WITHOUT any API keys (Mock LLM is the default).
# ---------------------------------------------------------------

# === Application ===
DEBUG=false
LOG_LEVEL=INFO

# === Database ===
# Default: SQLite in the project root (no setup required)
DATABASE_URL=sqlite+aiosqlite:///./sentinel_x.db

# === Security Settings ===
MAX_INPUT_CHARS=10000
REQUEST_RATE_LIMIT=60/minute

# === LLM Provider ===
# Options: mock | groq | gemini
# "mock" works without any API key and is the RECOMMENDED default.
DEFAULT_LLM_PROVIDER=mock

# === Optional: Groq API (free tier, 30 req/min) 🟡 ===
# Sign up at https://console.groq.com/ — free tier, no credit card required.
# Leave empty to use Mock LLM instead.
GROQ_API_KEY=

# === Optional: Google Gemini API (free tier) 🟡 ===
# Sign up at https://aistudio.google.com/ — free tier available.
# Leave empty to use Mock LLM instead.
GEMINI_API_KEY=

# === Risk Engine Weights ===
# These are configurable. They do NOT need to sum to 1;
# the engine normalizes them internally.
# Documented as provisional — tune experimentally.
WEIGHT_INJECTION=0.30
WEIGHT_PII=0.15
WEIGHT_SECRETS=0.20
WEIGHT_TOXICITY=0.15
WEIGHT_INTENT=0.10
WEIGHT_SESSION=0.10

# === Risk Thresholds (0-100) ===
RISK_LOW_MAX=20
RISK_MODERATE_MAX=40
RISK_HIGH_MAX=60
RISK_VERY_HIGH_MAX=80

# === Session Risk Thresholds ===
SESSION_WATCH_THRESHOLD=30
SESSION_HIGH_RISK_THRESHOLD=50
SESSION_RESTRICTED_THRESHOLD=70
SESSION_QUARANTINED_THRESHOLD=85

# === Logging (Security) ===
# IMPORTANT: Set LOG_RAW_INPUT=false in production to avoid logging user content.
LOG_RAW_INPUT=false
